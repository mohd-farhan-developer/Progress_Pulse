msgid "How much the p&itch rises as progress goes up:"
msgstr "随着进度上升音调升高的幅度(&I)："

#: progressPulse/__init__.py:601
msgid "Move the sound from &left ear to right ear as progress goes up"
msgstr "随着进度上升将声音从左耳移动到右耳(&L)"

#: progressPulse/__init__.py:607
msgid "&Volume (0 to 100):"
msgstr "音量（0 到 100）(&V)："

#: progressPulse/__init__.py:618
msgid "Let sounds &overlap when several progress bars move at the same time"
msgstr "当多个进度条同时移动时允许声音重叠(&O)"

#: progressPulse/__init__.py:627
msgid "&Announce when a progress bar finishes, for example \"Download complete\""
msgstr "当进度条完成时进行播报，例如“下载完成”(&A)"

#: progressPulse/__init__.py:633
msgid "&Test all sounds"
msgstr "测试所有声音(&T)"

#: progressPulse/__init__.py:645
msgid "None (silent, only the start, halfway and finished sounds play)"
msgstr "无（静音，仅播放开始、半程和结束声音）"

#: progressPulse/__init__.py:648
msgid "None (the regular sound plays)"
msgstr "无（播放常规声音）"

#: progressPulse/__init__.py:652
